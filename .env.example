# KulshAI — пример переменных окружения.
# Скопируй в .env.local для локального запуска (vercel dev) и заполни.
# На Vercel те же переменные задаются в Settings → Environment Variables.

# --- Модели: Google Gemini (можно 1–5 ключей, лишние оставь пустыми) ---
APIKEY1=
APIKEY2=
APIKEY3=
APIKEY4=
APIKEY5=

# --- Модели: NeutralBeats (DeepSeek / GLM / Kimi) ---
NEUTRALBEATS_API_KEY=
# Необязательно: другой base URL, по умолчанию https://api.neutralbeats.com/v1
NEUTRALBEATS_BASE_URL=

# --- Сессия и вход ---
# Любая случайная строка от 32 символов (openssl rand -base64 32)
AUTH_SECRET=
# Необязательно: основной адрес сайта без слэша на конце
SITE_URL=

# Telegram (необязательно)
TELEGRAM_BOT_TOKEN=

# GitHub (необязательно)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (необязательно)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- База данных: Upstash Redis (чаты, лимиты, скиллы, общий с ботом баланс и API-ключи) ---
# Vercel подставляет эти имена при Connect Project (или UPSTASH_* аналоги).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Деньги ---
# Курс для платных моделей (по умолчанию 90). Тот же, что у бота.
USD_TO_RUB=90
# Страница DonationAlerts для пополнения (та же, что у бота).
DONATIONALERTS_PAGE=https://www.donationalerts.com/r/starfallapk
